# Grating Coupler FDTD Design File
# This file contains the FDTD simulation setup for grating coupler
# Generated by Silicon Photonics Transceiver Project

# FDTD Simulation Region
# 3D simulation for grating coupler optimization
addfdtd;
set("dimension", "3D");
set("x", 0);
set("x span", 20e-6);
set("y", 0);
set("y span", 20e-6);
set("z", 0);
set("z span", 4e-6);
set("mesh accuracy", 3);
set("simulation time", 3000e-15);
set("auto shutoff min", 1e-6);

# Silicon substrate
addrect;
set("name", "substrate");
set("x", 0);
set("x span", 25e-6);
set("y", 0);
set("y span", 25e-6);
set("z min", -4e-6);
set("z max", 0);
set("material", "Si (Silicon) - Palik");

# BOX layer
addrect;
set("name", "BOX");
set("x", 0);
set("x span", 25e-6);
set("y", 0);
set("y span", 25e-6);
set("z min", 0);
set("z max", 2e-6);
set("material", "SiO2 (Glass) - Palik");

# Grating coupler
addrect;
set("name", "grating");
set("x", 0);
set("x span", 10e-6);
set("y", 0);
set("y span", 10e-6);
set("z", 0.11e-6);
set("z span", 0.22e-6);
set("material", "Si (Silicon) - Palik");

# Grating teeth (simplified)
for(i=0; i<20; i++) {
    addrect;
    set("name", "tooth_" + num2str(i));
    set("x", i*0.5e-6);
    set("x span", 0.25e-6);
    set("y", 0);
    set("y span", 10e-6);
    set("z", 0.11e-6);
    set("z span", 0.22e-6);
    set("material", "Si (Silicon) - Palik");
}

# Input waveguide
addrect;
set("name", "input_wg");
set("x", 10e-6);
set("x span", 5e-6);
set("y", 0);
set("y span", 0.45e-6);
set("z", 0.11e-6);
set("z span", 0.22e-6);
set("material", "Si (Silicon) - Palik");

# Fiber source (Gaussian beam)
addgaussian;
set("name", "fiber_source");
set("injection axis", "z");
set("x", 0);
set("y", 0);
set("z", 3e-6);
set("x span", 10e-6);
set("y span", 10e-6);
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);
set("beam width", 5e-6);
set("angle theta", 10);
set("angle phi", 0);

# Coupling efficiency monitor
addpower;
set("name", "coupling");
set("monitor type", "2D X-normal");
set("x", 12e-6);
set("y", 0);
set("y span", 1.35e-6);
set("z", 0.11e-6);
set("z span", 0.66e-6);

# Reflection monitor
addpower;
set("name", "reflection");
set("monitor type", "2D Z-normal");
set("x", 0);
set("y", 0);
set("z", 3e-6);
set("x span", 10e-6);
set("y span", 10e-6);

# Frequency domain monitor
addpower;
set("name", "freq_monitor");
set("monitor type", "2D Y-normal");
set("x", 0);
set("y", 0);
set("z", 0.11e-6);
set("x span", 20e-6);
set("z span", 0.22e-6);
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);

# Save project
save("grating_coupler_design.fsp");