# Silicon Ring Modulator FDTD Design File
# This file contains the complete FDTD simulation setup for the ring modulator
# Generated by Silicon Photonics Transceiver Project

# FDTD Simulation Region
# 3D simulation with optimized mesh
addfdtd;
set("dimension", "3D");
set("x", 0);
set("x span", 25e-6);
set("y", 0);
set("y span", 25e-6);
set("z", 0);
set("z span", 3e-6);
set("mesh accuracy", 3);
set("simulation time", 5000e-15);
set("auto shutoff min", 1e-6);

# Silicon substrate
addrect;
set("name", "substrate");
set("x", 0);
set("x span", 30e-6);
set("y", 0);
set("y span", 30e-6);
set("z min", -3e-6);
set("z max", 0);
set("material", "SiO2 (Glass) - Palik");

# BOX layer
addrect;
set("name", "BOX");
set("x", 0);
set("x span", 30e-6);
set("y", 0);
set("y span", 30e-6);
set("z min", 0);
set("z max", 2e-6);
set("material", "SiO2 (Glass) - Palik");

# Ring waveguide
addring;
set("name", "ring");
set("x", 0);
set("y", 0);
set("z", 0.11e-6);
set("inner radius", 9.775e-6);
set("outer radius", 10.225e-6);
set("z span", 0.22e-6);
set("material", "Si (Silicon) - Palik");

# Bus waveguide
addrect;
set("name", "bus_waveguide");
set("x", 0);
set("x span", 25e-6);
set("y", -10.15e-6);
set("y span", 0.45e-6);
set("z", 0.11e-6);
set("z span", 0.22e-6);
set("material", "Si (Silicon) - Palik");

# P+ doping region
addring;
set("name", "p_doping");
set("x", 0);
set("y", 0);
set("z", 0.11e-6);
set("inner radius", 9.775e-6);
set("outer radius", 10.225e-6);
set("z span", 0.11e-6);
set("material", "Si (Silicon) - Palik");

# N+ doping region
addring;
set("name", "n_doping");
set("x", 0);
set("y", 0);
set("z", 0.11e-6);
set("inner radius", 9.775e-6);
set("outer radius", 10.225e-6);
set("z span", 0.11e-6);
set("z min", 0.11e-6);
set("material", "Si (Silicon) - Palik");

# Optical source
addmode;
set("name", "input");
set("injection axis", "x");
set("x", -12e-6);
set("y", -10.15e-6);
set("y span", 1.35e-6);
set("z", 0.11e-6);
set("z span", 0.66e-6);
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);
set("mode selection", "fundamental TE mode");

# Through port monitor
addpower;
set("name", "through");
set("monitor type", "2D X-normal");
set("x", 12e-6);
set("y", -10.15e-6);
set("y span", 1.35e-6);
set("z", 0.11e-6);
set("z span", 0.66e-6);

# Drop port monitor
addpower;
set("name", "drop");
set("monitor type", "2D Y-normal");
set("x", 0);
set("y", 12e-6);
set("x span", 1.35e-6);
set("z", 0.11e-6);
set("z span", 0.66e-6);

# Frequency domain monitor
addpower;
set("name", "freq_monitor");
set("monitor type", "2D Z-normal");
set("x", 0);
set("y", 0);
set("z", 0.11e-6);
set("x span", 20e-6);
set("y span", 20e-6);
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);

# Save project
save("ring_modulator_design.fsp");