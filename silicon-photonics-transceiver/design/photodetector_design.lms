# Germanium Photodetector FDTD Design File
# This file contains the complete FDTD simulation setup for the Ge photodetector
# Generated by Silicon Photonics Transceiver Project

# FDTD Simulation Region
# 3D simulation with high mesh accuracy for Ge absorption
addfdtd;
set("dimension", "3D");
set("x", 10e-6);
set("x span", 30e-6);
set("y", 0);
set("y span", 15e-6);
set("z", 0);
set("z span", 3e-6);
set("mesh accuracy", 4);
set("simulation time", 2000e-15);
set("auto shutoff min", 1e-6);

# Silicon substrate
addrect;
set("name", "substrate");
set("x", 10e-6);
set("x span", 35e-6);
set("y", 0);
set("y span", 20e-6);
set("z min", -3e-6);
set("z max", -2e-6);
set("material", "Si (Silicon) - Palik");

# BOX layer
addrect;
set("name", "BOX");
set("x", 10e-6);
set("x span", 35e-6);
set("y", 0);
set("y span", 20e-6);
set("z min", -2e-6);
set("z max", 0);
set("material", "SiO2 (Glass) - Palik");

# Input silicon waveguide
addrect;
set("name", "si_waveguide");
set("x min", -5e-6);
set("x max", 0);
set("y", 0);
set("y span", 0.45e-6);
set("z", 0.11e-6);
set("z span", 0.22e-6);
set("material", "Si (Silicon) - Palik");

# Taper region
addrect;
set("name", "taper");
set("x min", 0);
set("x max", 5e-6);
set("y", 0);
set("y span", 0.45e-6);
set("z", 0.11e-6);
set("z span", 0.22e-6);
set("material", "Si (Silicon) - Palik");

# Germanium absorption layer
addrect;
set("name", "ge_layer");
set("x min", 5e-6);
set("x max", 25e-6);
set("y", 0);
set("y span", 10e-6);
set("z min", 0.11e-6);
set("z max", 0.61e-6);

# Create Ge material with absorption
mat = addmaterial("(n,k) Material");
set("name", "Germanium_1550");
setmaterial(mat, "Refractive Index", [1500e-9; 1600e-9], [4.2; 4.2], [0.01; 0.01]);
setnamed("ge_layer", "material", "Germanium_1550");

# P+ contact
addrect;
set("name", "p_contact");
set("x min", 5e-6);
set("x max", 25e-6);
set("y", 0);
set("y span", 2e-6);
set("z min", 0.61e-6);
set("z max", 0.71e-6);
set("material", "Si (Silicon) - Palik");

# N+ contact
addrect;
set("name", "n_contact");
set("x min", 5e-6);
set("x max", 25e-6);
set("y", 8e-6);
set("y span", 2e-6);
set("z min", 0.61e-6);
set("z max", 0.71e-6);
set("material", "Si (Silicon) - Palik");

# Optical source
addmode;
set("name", "optical_input");
set("injection axis", "x");
set("x", -3e-6);
set("y", 0);
set("y span", 1.35e-6);
set("z", 0.11e-6);
set("z span", 0.66e-6);
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);
set("mode selection", "fundamental TE mode");

# Absorption monitor
addpower;
set("name", "absorption");
set("monitor type", "3D");
set("x min", 5e-6);
set("x max", 25e-6);
set("y", 0);
set("y span", 10e-6);
set("z min", 0.11e-6);
set("z max", 0.61e-6);

# Transmission monitor
addpower;
set("name", "transmission");
set("monitor type", "2D X-normal");
set("x", 27e-6);
set("y", 0);
set("y span", 1.35e-6);
set("z", 0.11e-6);
set("z span", 0.66e-6);

# Frequency domain monitor
addpower;
set("name", "freq_monitor");
set("monitor type", "2D Z-normal");
set("x", 15e-6);
set("y", 5e-6);
set("z", 0.36e-6);
set("x span", 20e-6);
set("y span", 10e-6);
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);

# Save project
save("ge_photodetector_design.fsp");