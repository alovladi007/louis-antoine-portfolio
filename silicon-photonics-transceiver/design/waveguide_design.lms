# Silicon Waveguide MODE Design File
# This file contains the MODE simulation setup for waveguide analysis
# Generated by Silicon Photonics Transceiver Project

# MODE Simulation Region
# 2D simulation for waveguide mode analysis
addmode;
set("dimension", "2D Z");
set("x", 0);
set("x span", 4e-6);
set("y", 0);
set("y span", 2e-6);
set("z", 0.11e-6);
set("z span", 0.22e-6);
set("mesh accuracy", 4);

# Silicon substrate
addrect;
set("name", "substrate");
set("x", 0);
set("x span", 4e-6);
set("y", 0);
set("y span", 2e-6);
set("y min", -1e-6);
set("y max", 0);
set("material", "SiO2 (Glass) - Palik");

# BOX layer
addrect;
set("name", "BOX");
set("x", 0);
set("x span", 4e-6);
set("y", 0);
set("y span", 2e-6);
set("y min", 0);
set("y max", 2e-6);
set("material", "SiO2 (Glass) - Palik");

# Silicon waveguide
addrect;
set("name", "waveguide");
set("x", 0);
set("x span", 0.45e-6);
set("y", 0);
set("y span", 0.22e-6);
set("material", "Si (Silicon) - Palik");

# Mode source
addmode;
set("name", "mode_source");
set("injection axis", "x");
set("x", 0);
set("x span", 0.45e-6);
set("y", 0);
set("y span", 0.22e-6);
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);
set("mode selection", "fundamental TE mode");

# Mode monitor
addpower;
set("name", "mode_monitor");
set("monitor type", "2D X-normal");
set("x", 2e-6);
set("y", 0);
set("y span", 0.22e-6);

# Effective index calculation
addanalysis;
set("name", "effective_index");
set("analysis type", "Effective Index");
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);
set("wavelength points", 21);

# Group index calculation
addanalysis;
set("name", "group_index");
set("analysis type", "Group Index");
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);
set("wavelength points", 21);

# Loss calculation
addanalysis;
set("name", "loss");
set("analysis type", "Loss");
set("wavelength start", 1540e-9);
set("wavelength stop", 1560e-9);
set("wavelength points", 21);

# Save project
save("waveguide_design.fsp");