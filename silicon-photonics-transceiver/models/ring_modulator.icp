# Ring Modulator Compact Model for INTERCONNECT
# This file contains the compact model parameters for the silicon ring modulator
# Generated by Silicon Photonics Transceiver Project

# Ring Modulator Parameters
# Based on FDTD simulation results

# Physical parameters
ring_radius = 10e-6;           # Ring radius (m)
waveguide_width = 450e-9;      # Waveguide width (m)
waveguide_height = 220e-9;     # Waveguide height (m)
gap = 150e-9;                  # Coupling gap (m)
coupling_length = 5e-6;        # Coupling region length (m)

# Material parameters
n_si = 3.476;                  # Silicon refractive index @ 1550nm
n_sio2 = 1.444;                # SiO2 refractive index @ 1550nm
lambda_center = 1550e-9;       # Center wavelength (m)

# Electrical parameters
V_pi = 2.0;                    # V-pi voltage (V)
V_bias = -1.0;                 # Bias voltage (V)
C_junction = 15e-15;           # Junction capacitance (F)
R_series = 50;                 # Series resistance (Ohm)

# Optical parameters
free_spectral_range = 10e12;   # FSR (Hz)
through_port_loss = 3;         # Through port loss (dB)
extinction_ratio = 10;         # Extinction ratio (dB)
coupling_coefficient = 0.1;    # Coupling coefficient

# Frequency response
freq_start = 100e9;            # Start frequency (Hz)
freq_stop = 50e9;              # Stop frequency (Hz)
freq_points = 100;             # Number of frequency points

# Create frequency vector
freq = linspace(freq_start, freq_stop, freq_points);

# Calculate effective index
neff = n_si - 0.1 * (freq - c/lambda_center) / (c/lambda_center);

# Calculate group index
ng = neff + freq .* (neff - n_si) / (c/lambda_center);

# Calculate ring resonance frequency
f_resonance = c / (2 * pi * ring_radius * neff);

# Calculate coupling coefficient vs frequency
kappa = coupling_coefficient * ones(size(freq));

# Calculate through port transmission
T_through = 1 - kappa.^2;

# Calculate drop port transmission
T_drop = kappa.^2;

# Calculate phase response
phi_through = angle(T_through);
phi_drop = angle(T_drop);

# Save parameters to file
write("ring_modulator_params.txt", "freq\tneff\tng\tkappa\tT_through\tT_drop\tphi_through\tphi_drop");
for(i=1:length(freq)) {
    write("ring_modulator_params.txt", 
          num2str(freq(i)) + "\t" + num2str(neff(i)) + "\t" + num2str(ng(i)) + "\t" +
          num2str(kappa(i)) + "\t" + num2str(T_through(i)) + "\t" + num2str(T_drop(i)) + "\t" +
          num2str(phi_through(i)) + "\t" + num2str(phi_drop(i)), "a");
}

?"Ring modulator compact model parameters saved";
?"Center frequency: " + num2str(f_resonance/1e12) + " THz";
?"V-pi: " + num2str(V_pi) + " V";
?"Extinction ratio: " + num2str(extinction_ratio) + " dB";