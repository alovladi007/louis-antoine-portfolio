# Germanium Photodetector Compact Model for INTERCONNECT
# This file contains the compact model parameters for the Ge photodetector
# Generated by Silicon Photonics Transceiver Project

# Photodetector Parameters
# Based on FDTD simulation results

# Physical parameters
pd_length = 20e-6;             # Photodetector length (m)
pd_width = 10e-6;              # Photodetector width (m)
ge_thickness = 500e-9;         # Germanium thickness (m)
si_thickness = 220e-9;         # Silicon waveguide thickness (m)
taper_length = 5e-6;           # Taper length (m)

# Material parameters
n_ge = 4.2;                    # Germanium refractive index @ 1550nm
k_ge = 0.01;                   # Germanium extinction coefficient
n_si = 3.476;                  # Silicon refractive index @ 1550nm
lambda_center = 1550e-9;       # Operating wavelength (m)

# Electrical parameters
responsivity = 0.85;           # Responsivity (A/W)
dark_current = 100e-9;         # Dark current (A)
capacitance = 15e-15;          # Junction capacitance (F)
resistance = 50;               # Series resistance (Ohm)
bias_voltage = -2;             # Reverse bias voltage (V)

# Performance parameters
bandwidth = 25e9;              # 3dB bandwidth (Hz)
quantum_efficiency = 0.68;     # Quantum efficiency
sensitivity = -9;              # Sensitivity @ BER=1e-12 (dBm)

# Frequency response
freq_start = 100e9;            # Start frequency (Hz)
freq_stop = 1e9;               # Stop frequency (Hz)
freq_points = 100;             # Number of frequency points

# Create frequency vector
freq = linspace(freq_start, freq_stop, freq_points);

# Calculate frequency response (RC filter)
f_3db = 1 / (2 * pi * resistance * capacitance);
H_freq = 1 ./ (1 + 1i * freq / f_3db);

# Calculate responsivity vs frequency
R_freq = responsivity * abs(H_freq);

# Calculate quantum efficiency vs frequency
QE_freq = quantum_efficiency * abs(H_freq);

# Calculate noise current
i_shot = sqrt(2 * q * dark_current * bandwidth);
i_thermal = sqrt(4 * k_B * T * bandwidth / resistance);
i_total = sqrt(i_shot^2 + i_thermal^2);

# Calculate NEP (Noise Equivalent Power)
NEP = i_total / responsivity;

# Calculate sensitivity
P_sens = NEP * sqrt(2 * log(2));  # For BER = 1e-12

# Save parameters to file
write("ge_photodetector_params.txt", "freq\tR_freq\tQE_freq\tH_freq");
for(i=1:length(freq)) {
    write("ge_photodetector_params.txt", 
          num2str(freq(i)) + "\t" + num2str(R_freq(i)) + "\t" + 
          num2str(QE_freq(i)) + "\t" + num2str(abs(H_freq(i))), "a");
}

# Save performance summary
write("ge_photodetector_performance.txt", "Parameter\tValue\tUnits");
write("ge_photodetector_performance.txt", "Responsivity\t" + num2str(responsivity) + "\tA/W", "a");
write("ge_photodetector_performance.txt", "Bandwidth\t" + num2str(bandwidth/1e9) + "\tGHz", "a");
write("ge_photodetector_performance.txt", "Dark Current\t" + num2str(dark_current*1e9) + "\tnA", "a");
write("ge_photodetector_performance.txt", "Capacitance\t" + num2str(capacitance*1e15) + "\tfF", "a");
write("ge_photodetector_performance.txt", "Sensitivity\t" + num2str(sensitivity) + "\tdBm", "a");
write("ge_photodetector_performance.txt", "NEP\t" + num2str(NEP*1e15) + "\tpW", "a");

?"Germanium photodetector compact model parameters saved";
?"Responsivity: " + num2str(responsivity) + " A/W";
?"Bandwidth: " + num2str(bandwidth/1e9) + " GHz";
?"Sensitivity: " + num2str(sensitivity) + " dBm";