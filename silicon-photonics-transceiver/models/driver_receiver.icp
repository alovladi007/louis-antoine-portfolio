# Driver and Receiver Circuit Models for INTERCONNECT
# This file contains the electronic circuit models for the transceiver
# Generated by Silicon Photonics Transceiver Project

# Driver Circuit Parameters
# High-speed electrical driver for ring modulator

# Driver specifications
driver_gain = 2.0;             # Voltage gain (V)
driver_bandwidth = 40e9;       # 3dB bandwidth (Hz)
driver_noise_figure = 6;       # Noise figure (dB)
driver_output_impedance = 50;  # Output impedance (Ohm)
driver_power_consumption = 45e-3; # Power consumption (W)

# Driver frequency response
freq_start = 100e9;            # Start frequency (Hz)
freq_stop = 1e9;               # Stop frequency (Hz)
freq_points = 100;             # Number of frequency points

# Create frequency vector
freq = linspace(freq_start, freq_stop, freq_points);

# Calculate driver transfer function (single-pole filter)
f_3db_driver = driver_bandwidth;
H_driver = driver_gain ./ (1 + 1i * freq / f_3db_driver);

# Calculate driver noise
noise_density_driver = 10^(driver_noise_figure/10) * k_B * T / (driver_gain^2);

# Receiver Circuit Parameters
# Transimpedance amplifier and low-pass filter

# TIA specifications
tia_gain = 5000;               # Transimpedance gain (Ohm)
tia_bandwidth = 30e9;          # 3dB bandwidth (Hz)
tia_noise_density = 20e-12;    # Noise spectral density (A/sqrt(Hz))
tia_input_capacitance = 15e-15; # Input capacitance (F)
tia_feedback_resistance = 5000; # Feedback resistance (Ohm)

# LPF specifications
lpf_order = 4;                 # Filter order
lpf_cutoff_25g = 25e9 * 0.75; # Cutoff frequency for 25 Gbps (Hz)
lpf_cutoff_50g = 50e9 * 0.75; # Cutoff frequency for 50 Gbps (Hz)
lpf_type = "Bessel";           # Filter type

# Calculate TIA transfer function
f_3db_tia = tia_bandwidth;
H_tia = tia_gain ./ (1 + 1i * freq / f_3db_tia);

# Calculate LPF transfer function (4th order Bessel)
# Simplified approximation
f_cutoff = lpf_cutoff_25g;
H_lpf_25g = 1 ./ (1 + 1i * freq / f_cutoff).^4;

f_cutoff = lpf_cutoff_50g;
H_lpf_50g = 1 ./ (1 + 1i * freq / f_cutoff).^4;

# Calculate total receiver transfer function
H_receiver_25g = H_tia .* H_lpf_25g;
H_receiver_50g = H_tia .* H_lpf_50g;

# Calculate receiver noise
i_noise_tia = tia_noise_density * sqrt(tia_bandwidth);
i_noise_total = i_noise_tia;  # Simplified

# Calculate receiver sensitivity
P_sens_25g = i_noise_total / (responsivity * abs(H_receiver_25g(end)));
P_sens_50g = i_noise_total / (responsivity * abs(H_receiver_50g(end)));

# Save driver parameters
write("driver_params.txt", "freq\tH_driver\tnoise_density");
for(i=1:length(freq)) {
    write("driver_params.txt", 
          num2str(freq(i)) + "\t" + num2str(abs(H_driver(i))) + "\t" + 
          num2str(noise_density_driver), "a");
}

# Save receiver parameters
write("receiver_params_25g.txt", "freq\tH_tia\tH_lpf\tH_total");
for(i=1:length(freq)) {
    write("receiver_params_25g.txt", 
          num2str(freq(i)) + "\t" + num2str(abs(H_tia(i))) + "\t" + 
          num2str(abs(H_lpf_25g(i))) + "\t" + num2str(abs(H_receiver_25g(i))), "a");
}

write("receiver_params_50g.txt", "freq\tH_tia\tH_lpf\tH_total");
for(i=1:length(freq)) {
    write("receiver_params_50g.txt", 
          num2str(freq(i)) + "\t" + num2str(abs(H_tia(i))) + "\t" + 
          num2str(abs(H_lpf_50g(i))) + "\t" + num2str(abs(H_receiver_50g(i))), "a");
}

# Save performance summary
write("driver_receiver_performance.txt", "Parameter\tValue\tUnits");
write("driver_receiver_performance.txt", "Driver Gain\t" + num2str(driver_gain) + "\tV", "a");
write("driver_receiver_performance.txt", "Driver Bandwidth\t" + num2str(driver_bandwidth/1e9) + "\tGHz", "a");
write("driver_receiver_performance.txt", "TIA Gain\t" + num2str(tia_gain) + "\tOhm", "a");
write("driver_receiver_performance.txt", "TIA Bandwidth\t" + num2str(tia_bandwidth/1e9) + "\tGHz", "a");
write("driver_receiver_performance.txt", "LPF Cutoff 25G\t" + num2str(lpf_cutoff_25g/1e9) + "\tGHz", "a");
write("driver_receiver_performance.txt", "LPF Cutoff 50G\t" + num2str(lpf_cutoff_50g/1e9) + "\tGHz", "a");
write("driver_receiver_performance.txt", "Driver Power\t" + num2str(driver_power_consumption*1000) + "\tmW", "a");

?"Driver and receiver circuit models saved";
?"Driver bandwidth: " + num2str(driver_bandwidth/1e9) + " GHz";
?"TIA gain: " + num2str(tia_gain) + " Ohm";
?"TIA bandwidth: " + num2str(tia_bandwidth/1e9) + " GHz";